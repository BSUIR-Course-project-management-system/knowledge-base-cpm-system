[run]
omit =
    schedule_module/src/main.py
    schedule_module/src/utils.py
    schedule_module/src/logger.py
    search_module/src/main.py
    recomendation_module/src/main.py
    search_module/src/utils.py
    **/tests/*
    **/__init__.py

[report]
show_missing = True
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.: