# OpenAlex
OPENALEX_BASE_URL=https://api.openalex.org/works
OPENALEX_MAILTO=
OPENALEX_TIMEOUT=25
OPENALEX_RETRIES=2

# Embedding model. BGE-M3 is multilingual and suitable for Russian/English text.
MODEL_NAME=BAAI/bge-m3
HF_HOME=/models

# Number of candidate works fetched before semantic reranking
CANDIDATE_LIMIT=50
