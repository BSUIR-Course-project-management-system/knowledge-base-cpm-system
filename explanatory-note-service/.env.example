# Куда писать результаты .tex (в контейнере — точка bind mount).
OUTPUT_DIR=/app/out

# Опционально: пути к шаблонам и схеме полей (по умолчанию лежат внутри app/).
# FIELDS_PATH=/app/app/task_sheet_filler/config/fields.json
# TEMPLATES_DIR=/app/app/task_sheet_filler/templates

# Опционально: путь к машиночитаемому набору правил проверки записки.
# RULES_PATH=/app/app/note_checker/rules/data/rules.json

# Опционально: стартовые системные данные. Если не задано, используются
# встроенные значения (бывший config/system.json). Изменяются через
# PUT/PATCH /api/v1/system.
# SYSTEM_JSON='{"year":"2026","specialty_code":"1-11-1111-01","topic_prefix":"Решатель задач","submission_date":"05.12.2026","date_task_assign":"12.09.2026","semester_numb":"5","course_project_subject":"Проектирование баз знаний","department_head":"И. О. Фамилия","note_section_prefixes":["Анализ","Проектирование","Разработка"],"note_blank_rows":7}'

# Пределы входных файлов POST /notes:check.
# MAX_NOTE_BYTES=52428800
# MAX_TEX_FILE_BYTES=2097152
# MAX_NOTE_FILES=200

# Черновик модуля орфографии (может выдавать ложные значения). Чтобы убрать проверку, удалите каталог
# app/note_checker/spelling — остальной сервис продолжит работать.
# SPELLCHECK_ENABLED=true
# SPELLER_URL=https://speller.yandex.net/services/spellservice.json/checkText
# SPELLER_TIMEOUT_SECONDS=10
# SPELLER_RETRIES=1
# SPELLER_CHUNK_CHARS=9500
# SPELLER_PARALLEL_REQUESTS=2
# SPELLING_DICTIONARY_PATH=/app/app/note_checker/spelling/data/spelling_dictionary.txt
